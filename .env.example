# Copy these into the shell before starting the dashboard.
# This app reads environment variables. It does not load this file by itself.
# Do not put real passwords in this file. Put them in LOCAL.md, which is gitignored.

SERVICEBRIDGE_NOW_URL=https://YOUR_INSTANCE.service-now.com/api/YOUR_SCOPE/servicebridge/monitor/events
SERVICEBRIDGE_NOW_USER=servicebridge.integration
SERVICEBRIDGE_NOW_PASSWORD=
